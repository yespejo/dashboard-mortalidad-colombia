# Variables de entorno para el Dashboard de Mortalidad
# Copia este archivo como .env y configura los valores según tu entorno

# Configuración de Flask
FLASK_ENV=production
PORT=5000

# Configuración de Python
PYTHON_VERSION=3.9.18

# Configuración opcional para desarrollo local
# FLASK_DEBUG=False

# Variables específicas para Railway
RAILWAY_ENVIRONMENT=production
NIXPACKS_PYTHON_VERSION=3.9
